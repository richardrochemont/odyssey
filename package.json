{
  "name": "hearthlane-monorepo",
  "private": true,
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "start:web": "pnpm --filter @hearthlane/web run start",
    "start:api": "pnpm --filter @hearthlane/api run start",
    "start": "pnpm --filter @hearthlane/web run start",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\""
  },
  "devDependencies": {
    "prettier": "^3.2.5",
    "turbo": "^1.13.0",
    "typescript": "^5.4.5"
  },
  "packageManager": "pnpm@9.1.0"
}
