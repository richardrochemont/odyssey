# Hearthlane Environment Variables Example

# Database (PostgreSQL)
DATABASE_URL="postgres://postgres:password@localhost:5432/hearthlane"

# Redis (BullMQ / Caching)
REDIS_URL="redis://localhost:6379"

# API Port Configuration
PORT=4000

# Next.js Web App API & Canonical Application URL
NEXT_PUBLIC_API_URL="http://localhost:4000"
APP_URL="http://localhost:3000" # Production: https://odyssey.investments (HTTPS required, no localhost)

# Transactional Email Provider Config
EMAIL_PROVIDER="noop" # "noop" (default/dev/test) | "resend"
EMAIL_ENABLED="false" # "true" to activate sending | "false" to skip delivery safely
RESEND_API_KEY="re_123456789" # Required only when EMAIL_ENABLED="true"
EMAIL_FROM="Odyssey <invitations@odyssey.investments>" # Verified sender address
EMAIL_REPLY_TO="support@odyssey.investments"

# Secret key for local JWT fallback developer auth
JWT_SECRET="local-development-secret-jwt-key-change-in-production"

# Clerk Auth Config (Ready for Production deployment)
CLERK_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."

# S3 Compatible Storage Config (Local fallback is used if these are empty)
AWS_ACCESS_KEY_ID="minioadmin"
AWS_SECRET_ACCESS_KEY="minioadmin"
AWS_REGION="us-east-1"
AWS_BUCKET_NAME="hearthlane-attachments"
AWS_S3_ENDPOINT="http://localhost:9000" # optional endpoint for MinIO

# Sentry (Error Tracking)
SENTRY_DSN=""

# PostHog (Analytics)
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"
